import pytest from types import SimpleNamespace from 
unittest.mock import AsyncMock from 
app.services.daily_office_report_service import 
DailyOfficeReportService @pytest.fixture def db():
    return AsyncMock() @pytest.fixture def service(db): return 
    DailyOfficeReportService(db)
def mock_execute(result): execute = AsyncMock() 
    execute.return_value = result return execute
@pytest.mark.asyncio async def 
test_upsert_creates_new_report(service, db):
    office = SimpleNamespace( id="office-1", 
        office_code="GPO001", office_name="Nagpur GPO",
    ) office_result = AsyncMock() 
    office_result.scalar_one_or_none.return_value = office 
    report_result = AsyncMock() 
    report_result.scalar_one_or_none.return_value = None 
    db.execute.side_effect = [
        office_result, report_result, ] db.add = AsyncMock() 
    db.commit = AsyncMock() db.refresh = AsyncMock() payload = {
        "office_code": "GPO001", "report_date": "2026-07-31", 
        "sb_opened": 5,
    }
    report = await service.upsert(payload) assert 
    report.office_code == "GPO001" assert report.office_name == 
    "Nagpur GPO" assert report.sb_opened == 5 
    db.add.assert_called_once() db.commit.assert_awaited_once() 
    db.refresh.assert_awaited_once()
@pytest.mark.asyncio async def 
test_upsert_updates_existing_report(service, db):
    office = SimpleNamespace( id="office-1", 
        office_code="GPO001", office_name="Nagpur GPO",
    ) existing_report = SimpleNamespace( office_id="office-1", 
        office_code="GPO001", office_name="Nagpur GPO", 
        sb_opened=2,
    ) office_result = AsyncMock() 
    office_result.scalar_one_or_none.return_value = office 
    report_result = AsyncMock() 
    report_result.scalar_one_or_none.return_value = 
    existing_report db.execute.side_effect = [
        office_result, report_result, ] db.add = AsyncMock() 
    db.commit = AsyncMock() db.refresh = AsyncMock() payload = {
        "office_code": "GPO001", "report_date": "2026-07-31", 
        "sb_opened": 20,
    }
    report = await service.upsert(payload) assert 
    report.sb_opened == 20
    # Existing report + SyncError log
    assert db.add.call_count == 1 
    db.commit.assert_awaited_once() 
    db.refresh.assert_awaited_once()
@pytest.mark.asyncio async def 
test_upsert_invalid_office(service, db):
    office_result = AsyncMock() 
    office_result.scalar_one_or_none.return_value = None 
    db.execute.side_effect = [
        office_result, office_result, ] payload = { 
        "office_code": "INVALID", "office_name": "Unknown", 
        "report_date": "2026-07-31",
    }
    with pytest.raises(ValueError, match="Office not found"): 
        await service.upsert(payload)
@pytest.mark.asyncio async def 
test_upsert_missing_report_date(service, db):
    office = SimpleNamespace( id="office-1", 
        office_code="GPO001", office_name="Nagpur GPO",
    ) office_result = AsyncMock() 
    office_result.scalar_one_or_none.return_value = office 
    db.execute.return_value = office_result payload = {
        "office_code": "GPO001",
    }
    with pytest.raises(ValueError, match="report_date is required"):
        await service.upsert(payload)
