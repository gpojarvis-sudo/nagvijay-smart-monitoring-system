# =============================================================================
# NagVijay Smart Monitoring System - Environment Variables
# Copy this file to .env and fill all values. Never commit .env to GitHub.
# =============================================================================

# ------------------------ Core Application ------------------------
APP_NAME=NagVijay Smart Monitoring System
APP_ENV=development
APP_VERSION=1.0.0-MVP
API_V1_PREFIX=/api/v1
DEBUG=True
HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_URL=
BACKEND_URL=
CORS_ORIGINS=

# ------------------------ Database / Supabase ------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ------------------------ Security / JWT ------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nagvijay-nsms
BCRYPT_ROUNDS=12

# ------------------------ Google OAuth ------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_SCOPES=openid email profile

# ------------------------ Google APIs ------------------------
GOOGLE_SHEETS_API_ENABLED=True
GOOGLE_FORMS_API_ENABLED=True
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_FORMS_WEBHOOK_SECRET=

# ------------------------ AI / Gemini ------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=2048

# ------------------------ Automation / n8n ------------------------
N8N_WEBHOOK_URL=
N8N_API_KEY=
N8N_ENABLED=False

# ------------------------ Email (via n8n or SMTP) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nagvijay.india-post

# ------------------------ Logging & Monitoring ------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
ENABLE_AUDIT_LOGS=True

# ------------------------ Railway / Deployment ------------------------
RAILWAY_ENVIRONMENT=
RAILWAY_PROJECT_ID=
PORT=8000

# ------------------------ Redis / Celery (Optional for scheduler) ------------------------
REDIS_URL=
CELERY_BROKER_URL=

# ------------------------ Rate Limiting ------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ------------------------ Feature Flags ------------------------
ENABLE_GOOGLE_FORMS_SYNC=True
ENABLE_GOOGLE_SHEETS_SYNC=True
ENABLE_AI_CHATBOT=True
ENABLE_NOTIFICATIONS=True
ENABLE_SCHEDULER=True

# ------------------------ Next.js (Root Preview) ------------------------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
